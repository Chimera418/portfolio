---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import TechStack from "../components/TechStack.astro";

// Newest-first. All roles are ongoing ("Present").
const timeline = [
  {
    date: "2026 — Present",
    role: "CTF Player",
    org: "Void Walkers",
    description:
      "More CTFs, more challenges, and hoping to actually understand heap exploitation someday.",
  },
  {
    date: "2026 — Present",
    role: "Senior Executive",
    org: "GDG ASEB",
    description:
      "Google Developer Groups on campus. Helping run events and keep the chaos organized.",
  },
  {
    date: "2025 — Present",
    role: "President",
    org: "CSI Student Chapter ASEB",
    description:
      "Somehow became the person in charge. Still figuring out how that happened.",
  },
  {
    date: "2025 — Present",
    role: "CTF Player",
    org: "Bi0s",
    description:
      "Started breaking into things legally — web exploitation and reverse engineering, mostly staring at hex dumps at 3 AM.",
  },
  {
    date: "2024 — Present",
    role: "Senior Executive",
    org: "FORGE",
    description:
      "Forum of Game Engineering. Yes, the name is cool. Yes, that mattered when I joined.",
  },
  {
    date: "2024 — Present",
    role: "Tech Team Member",
    org: "ACM Student Chapter ASEB",
    description:
      "Joined the tech team. Mostly broke things first, then figured out how to fix them. Sometimes in that order.",
  },
];

const languages = ["Python", "C", "C++", "JavaScript", "TypeScript", "SQL", "Bash"];
const frontend = ["React.js", "Next.js", "Astro", "Tailwind CSS", "Vite"];
const backend = ["Node.js", "Express.js", "FastAPI", "Flask"];
const security = ["Burp Suite", "Wireshark", "Nmap", "SQLi", "XSS", "CSRF"];
const tools = ["Git", "Linux", "Docker", "MATLAB", "Figma", "Canva"];
const spokenLanguages = ["English", "Kannada", "Telugu", "Hindi (basic)", "Tamil (basic)"];

const facts = [
  {
    chip: "PARTY TRICK",
    chipColor: "text-primary",
    borderColor: "hover:border-primary/50",
    title: "Sub-30 Rubik's Cube",
    subtitle: "Not world record, but enough to make someone's jaw drop at a party.",
  },
  {
    chip: "COLLECTOR",
    chipColor: "text-tertiary",
    borderColor: "hover:border-tertiary/50",
    title: "Random Stuff",
    subtitle: "I get obsessed with collecting the most random things — guitar picks, stickers, etc.",
  },
  {
    chip: "FUEL",
    chipColor: "text-rosewater",
    borderColor: "hover:border-rosewater/50",
    title: "Chocolate, obviously",
    subtitle: "Not coffee, not energy drinks, not tea. Just chocolate. Every time.",
  },
  {
    chip: "MEDIA",
    chipColor: "text-sky",
    borderColor: "hover:border-sky/50",
    title: "JJK & The Silent Patient",
    subtitle: "Anime, manga, novels — I consume it all.",
  },
  {
    chip: "SCHEDULE",
    chipColor: "text-green",
    borderColor: "hover:border-green/50",
    title: "Night owl. Or early bird.",
    subtitle: "Depends on deadlines, vibes, and what YouTube recommended at 2am.",
  },
];
---

<Layout title="About | Chimera's Realm">
  <Navbar />

  <!-- Enable reveal state before paint so there's no flash of content -->
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("reveal-on");
    }
  </script>

  <div class="mt-8 max-w-4xl mx-auto space-y-20 pb-20">
    <!-- Header -->
    <section class="reveal">
      <p class="font-pixel text-xs text-primary mb-4 tracking-widest">WHO AM I</p>
      <h1
        class="text-4xl md:text-5xl font-bold text-text-primary mb-6 leading-tight"
      >
        I am<br />
        <span class="text-primary">Aneesh Sagar Reddy.</span>
      </h1>
      <div class="text-lg text-text-muted leading-relaxed space-y-4 max-w-2xl">
        <p>
          I'm a <span class="text-primary">Computer Science (AI)</span> student at
          <span class="text-primary">Amrita Vishwa Vidyapeetham, Bengaluru</span>.
          Most of what I make lands somewhere between "this solves a real problem"
          and "I was curious what would happen."
        </p>
        <p>
          A lot of it is web apps, some of it is taking things apart to see how
          they work, and a fair amount is automating stuff I didn't want to do
          twice. Most projects start from a small annoyance that wouldn't leave my
          head.
        </p>
        <p>
          Some turn out useful. A few even get finished. On a slow weekend I'm
          usually buried in a CTF challenge, or adding yet another half-done side
          project to the pile of tabs I keep meaning to close.
        </p>
      </div>
    </section>

    <!-- Quick Stats / Vibes -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div
        class="reveal bg-overlay border-2 border-highlight-med rounded-xl p-5 hover:border-primary/50 transition-colors group"
      >
        <p class="font-pixel text-xs text-primary mb-2 tracking-wider">STYLE</p>
        <p
          class="text-text-primary font-bold text-lg group-hover:text-primary transition-colors"
        >
          Eh, why not?
        </p>
        <p class="text-text-muted text-sm mt-1">
          Chaotic, but with a plan. Somewhere.
        </p>
      </div>
      <div
        class="reveal bg-overlay border-2 border-highlight-med rounded-xl p-5 hover:border-tertiary/50 transition-colors group"
        style="transition-delay:80ms"
      >
        <p class="font-pixel text-xs text-tertiary mb-2 tracking-wider">
          ACTUALLY
        </p>
        <p
          class="text-text-primary font-bold text-lg group-hover:text-tertiary transition-colors"
        >
          Would've been a video editor
        </p>
        <p class="text-text-muted text-sm mt-1">If code didn't happen first.</p>
      </div>
    </section>

    <!-- Timeline -->
    <section>
      <h2
        class="reveal text-2xl font-bold text-text-primary mb-2 flex items-center gap-4"
      >
        <svg
          class="w-6 h-6 text-primary"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" x2="21" y1="22" y2="22"></line>
          <line x1="6" x2="6" y1="18" y2="11"></line>
          <line x1="10" x2="10" y1="18" y2="11"></line>
          <line x1="14" x2="14" y1="18" y2="11"></line>
          <line x1="18" x2="18" y1="18" y2="11"></line>
          <polygon points="12 2 20 7 4 7"></polygon>
        </svg>
        Places That Let Me In
      </h2>
      <p class="reveal text-text-muted text-sm mb-8 ml-10">
        Clubs, communities, and other places I somehow ended up in — newest first.
      </p>
      <div class="relative pl-1 py-2">
        <!-- Vertical rail -->
        <div class="absolute left-[6px] top-3 bottom-3 w-px bg-highlight-med/60"></div>
        {
          timeline.map((item, idx) => (
            <div
              class="reveal relative pl-8 pb-9 last:pb-0"
              style={`transition-delay:${idx * 70}ms`}
            >
              {/* Dot on the rail */}
              <div class="absolute left-0 top-[3px] w-3.5 h-3.5 rounded-full bg-primary border-2 border-surface shadow-[0_0_10px_var(--primary)]" />
              <div class="font-pixel text-[9px] text-primary uppercase tracking-widest">
                {item.date}
              </div>
              <h3 class="font-bold text-text-primary text-base mt-2.5">
                {item.role} <span class="text-highlight-med px-0.5">·</span>{" "}
                <span class="text-primary">{item.org}</span>
              </h3>
              <p class="text-text-muted text-sm mt-1.5 max-w-[62ch] leading-relaxed">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Tech Stack -->
    <section id="skills">
      <h2
        class="reveal text-2xl font-bold text-text-primary mb-2 flex items-center gap-4"
      >
        <svg
          class="w-6 h-6 text-secondary"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
          ></path></svg
        >
        Current Loadout
      </h2>
      <p class="reveal text-text-muted text-sm mb-8 ml-10">
        Things I actually use. GitHub has more receipts.
      </p>
      <div
        class="reveal bg-overlay border-2 border-highlight-med rounded-xl p-6 md:p-8"
      >
        <TechStack category="Spoken Languages" skills={spokenLanguages} />
        <TechStack category="Programming Languages" skills={languages} />
        <TechStack category="Frontend" skills={frontend} />
        <TechStack category="Backend" skills={backend} />
        <TechStack category="Security" skills={security} />
        <TechStack category="Tools" skills={tools} />
      </div>
    </section>

    <!-- Fun Facts -->
    <section>
      <h2
        class="reveal text-2xl font-bold text-text-primary mb-2 flex items-center gap-4"
      >
        <svg
          class="w-6 h-6 text-tertiary"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"
          ></path></svg
        >
        Other Than That
      </h2>
      <p class="reveal text-text-muted text-sm mb-8 ml-10">
        The stuff that doesn't go on a résumé.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          facts.map((fact, idx) => (
            <div
              class={`reveal bg-overlay border-2 border-highlight-med rounded-xl p-5 transition-colors group ${fact.borderColor}`}
              style={`transition-delay:${idx * 60}ms`}
            >
              <p class={`font-pixel text-xs tracking-wider mb-3 ${fact.chipColor}`}>
                {fact.chip}
              </p>
              <p class="font-bold text-base text-text-primary mb-1">{fact.title}</p>
              <p class="text-text-muted text-sm leading-relaxed">{fact.subtitle}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Sign-off -->
    <section class="reveal border-t border-highlight-med pt-10 text-center">
      <p class="text-text-muted text-sm leading-relaxed max-w-lg mx-auto">
        If you made it this far, thanks for reading. Want to build something,
        break something, or just talk tech? My inbox is open.
      </p>
      <p class="font-pixel text-xs text-primary mt-4 tracking-widest">— peace</p>
    </section>
  </div>
</Layout>

<style>
  /* Scroll-reveal — only active when JS adds `reveal-on` (so no-JS / reduced
     motion always sees content). Items animate from a visible resting concept. */
  html.reveal-on .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  html.reveal-on .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html.reveal-on .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  let io: IntersectionObserver | undefined;

  function setupReveal() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.remove("reveal-on");
      return;
    }
    document.documentElement.classList.add("reveal-on");

    if (!io) {
      io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io!.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
      );
    }

    const vh = window.innerHeight;
    document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) => {
      // Anything already in view or scrolled past reveals immediately;
      // only below-the-fold items wait for the scroll animation.
      if (el.getBoundingClientRect().top < vh * 0.95) {
        el.classList.add("is-visible");
      } else {
        io!.observe(el);
      }
    });
  }

  setupReveal();
  document.addEventListener("astro:page-load", setupReveal);
</script>
