      <!-- Peripherals (Keyboard & Mouse) -->
      <div class="flex items-end justify-center gap-4 md:gap-8 w-full px-2 z-0" style="transform: rotateX(20deg) translateY(-10px);">
        <!-- Keyboard -->
        <div class="css-keyboard relative bg-[#d8d8d8] rounded-sm p-2 md:p-3 w-[65%] md:w-[50%] aspect-[3/1] flex flex-col gap-1 shadow-[0_20px_40px_rgba(0,0,0,0.6)]">
