        <!-- Monitor Power Button & LED -->
        <div class="absolute bottom-1 right-2 md:bottom-3 md:right-8 flex items-center gap-1.5 md:gap-3">
          <div class="w-1.5 h-1.5 md:w-2.5 md:h-2.5 rounded-none bg-green shadow-[0_0_12px_var(--green)]"></div>
          <div class="text-[6px] md:text-[9px] text-gray-500 font-sans font-bold tracking-widest uppercase">Power</div>
        </div>
