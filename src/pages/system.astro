---
// No layout used because we want a completely custom standalone view
import "../styles/global.css";

// Import game components for the Games window
import ChromeDino  from '../components/os-games/ChromeDino.astro';
import Snake       from '../components/os-games/Snake.astro';
import Tetris      from '../components/os-games/Tetris.astro';
import Game2048    from '../components/os-games/Game2048.astro';
import FlappyBird  from '../components/os-games/FlappyBird.astro';
import MemoryMatch from '../components/os-games/MemoryMatch.astro';
import TicTacToe   from '../components/os-games/TicTacToe.astro';
import Wordle      from '../components/os-games/Wordle.astro';
import Connect4    from '../components/os-games/Connect4.astro';
import DontWordle  from '../components/os-games/DontWordle.astro';
import ColorGuesser from '../components/os-games/ColorGuesser.astro';
import GravityMaze from '../components/os-games/GravityMaze.astro';

const projectFiles = Object.values(import.meta.glob('../content/projects/*.md', { eager: true }));
const projects = projectFiles.map((file: any) => ({
  id: file.file.split('/').pop().replace('.md', ''),
  title: file.frontmatter.title,
  description: file.frontmatter.description
}));
---
<!doctype html>
<html lang="en" data-theme="mocha">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Chimera OS" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/chimera-favicon.svg" />
    <title>Chimera OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#111] h-[100dvh] flex flex-col items-center justify-center overflow-hidden perspective-[1200px]">
    <!-- Desk Setup Container -->
    <div class="flex flex-col items-center justify-center gap-4 md:gap-6 w-full max-w-[calc(70vh*1.6)] px-2 md:px-0 transform-style-preserve-3d" style="transform: rotateX(2deg);">
      
      <!-- Physical Monitor Frame -->
      <div class="monitor-frame relative w-full bg-[#e4e4e4] rounded-sm p-4 md:p-8 shadow-[0_40px_100px_rgba(0,0,0,0.8),inset_0_2px_5px_rgba(255,255,255,0.8),inset_0_-5px_15px_rgba(0,0,0,0.2)] mx-auto z-10 transition-transform hover:scale-[1.01] duration-500" style="aspect-ratio: 16/10;">
        <!-- Inner Bezel -->
        <div class="inner-bezel w-full h-full bg-[#3a3a3a] rounded-sm p-3 md:p-6 shadow-[inset_0_0_15px_rgba(0,0,0,0.9)] relative">
          <!-- The Actual CRT Screen -->
          <div class="crt-screen relative w-full h-full bg-[#008080] rounded-sm overflow-hidden shadow-[inset_0_0_80px_rgba(0,0,0,1)] border-[4px] border-[#111]">
            <!-- Screen Glare / Reflection -->
            <div class="absolute inset-0 pointer-events-none z-50 bg-gradient-to-br from-white/10 via-transparent to-transparent rounded-sm"></div>
            
            <!-- Desktop Environment -->
            <div id="desktop" class="absolute inset-0 pb-8 p-4 flex flex-col gap-6 flex-wrap content-start z-10">
              <!-- Desktop Icons -->
              <div class="desktop-icon cursor-pointer flex flex-col items-center text-center w-16" data-target="window-terminal" ondblclick="openWindow('window-terminal')">
                <div class="w-10 h-10 mb-1 bg-black border-2 border-gray-400 flex items-center justify-center text-green text-[10px] font-pixel shadow-sm transition-transform active:scale-95">C:\</div>
                <span class="text-white text-[10px] font-sans font-bold bg-[#008080] px-1 truncate w-full">Terminal</span>
              </div>
              
              <div class="desktop-icon cursor-pointer flex flex-col items-center text-center w-16" data-target="window-games" ondblclick="openWindow('window-games')">
                <div class="w-10 h-10 mb-1 bg-yellow-400 text-2xl flex items-center justify-center border-2 border-white shadow-sm shadow-black/50 transition-transform active:scale-95">📁</div>
                <span class="text-white text-[10px] font-sans font-bold bg-[#008080] px-1 truncate w-full">Games</span>
              </div>

              <div class="desktop-icon cursor-pointer flex flex-col items-center text-center w-16" data-target="window-devlogs" ondblclick="openWindow('window-devlogs')">
                <div class="w-10 h-10 mb-1 bg-yellow-400 text-2xl flex items-center justify-center border-2 border-white shadow-sm shadow-black/50 transition-transform active:scale-95">📁</div>
                <span class="text-white text-[10px] font-sans font-bold bg-[#008080] px-1 truncate w-full">Archives</span>
              </div>

              <div class="desktop-icon cursor-pointer flex flex-col items-center text-center w-16" data-target="window-labs" ondblclick="openWindow('window-labs')">
                <div class="w-10 h-10 mb-1 bg-yellow-400 text-2xl flex items-center justify-center border-2 border-white shadow-sm shadow-black/50 transition-transform active:scale-95">📁</div>
                <span class="text-white text-[10px] font-sans font-bold bg-[#008080] px-1 truncate w-full">Labs</span>
              </div>

              <div class="desktop-icon cursor-pointer flex flex-col items-center text-center w-16" data-target="window-readme" ondblclick="openWindow('window-readme')">
                <div class="w-10 h-10 mb-1 bg-white border border-gray-400 flex items-center justify-center text-[10px] text-black font-serif shadow-sm transition-transform active:scale-95">TXT</div>
                <span class="text-white text-[10px] font-sans font-bold bg-[#008080] px-1 truncate w-full">readme</span>
              </div>
            </div>

            <!-- Windows Container -->
            <div id="windows-container" class="absolute inset-0 pointer-events-none z-30 overflow-hidden pb-[28px]">
              
              <!-- Terminal Window -->
              <div id="window-terminal" class="os-window hidden absolute top-4 left-4 w-[85%] h-[80%] bg-surface-container border-[3px] border-gray-200 shadow-[2px_2px_10px_rgba(0,0,0,0.5)] pointer-events-auto flex flex-col" onmousedown="bringToFront(this)">
                <div class="window-titlebar bg-[#000080] text-white flex justify-between items-center px-1.5 py-1 border-b-2 border-gray-300 cursor-default select-none">
                  <span class="font-pixel text-[8px] tracking-widest">Command Prompt</span>
                  <button class="close-btn bg-[#c0c0c0] text-black border-t-2 border-l-2 border-white border-b-2 border-r-2 border-gray-600 w-4 h-4 flex items-center justify-center font-bold text-[10px] leading-none active:border-t-gray-600 active:border-l-gray-600 active:border-b-white active:border-r-white" onclick="closeWindow('window-terminal')">x</button>
                </div>
                <div class="window-content flex-grow relative bg-[#111]">
                  <!-- Terminal Content -->
                  <div id="terminal-container" class="absolute inset-0 p-3 overflow-y-auto break-words font-pixel text-[8px] md:text-[10px] leading-relaxed text-primary custom-scroll" onclick="document.getElementById('cmd-input').focus()">
                      <div id="terminal-output" class="flex flex-col gap-1 pb-2 tracking-wider leading-loose">
                      <div class="text-secondary mb-4">
                        CHIMERA OS [Version 1.0.42]<br/>
                        (c) Chimera Corporation. All rights reserved.<br/><br/>
                        Type 'help' for commands.
                      </div>
                    </div>
                    <div class="flex items-center text-text-primary w-full">
                      <span class="text-green mr-2 font-bold shrink-0" id="prompt-prefix">C:\></span>
                      <input type="text" id="cmd-input" class="flex-grow min-w-0 w-full bg-transparent border-none outline-none text-text-primary font-pixel text-[8px] md:text-[10px] tracking-wider caret-primary" autocomplete="off" spellcheck="false" />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Games Folder Window -->
              <div id="window-games" class="os-window hidden absolute top-8 left-8 w-[80%] h-[70%] bg-[#c0c0c0] border-[3px] border-gray-200 shadow-[2px_2px_10px_rgba(0,0,0,0.5)] pointer-events-auto flex flex-col" onmousedown="bringToFront(this)">
                <div class="window-titlebar bg-[#000080] text-white flex justify-between items-center px-1.5 py-1 cursor-default select-none">
                  <span class="font-pixel text-[8px] tracking-widest">C:\GAMES</span>
                  <button class="close-btn bg-[#c0c0c0] text-black border-t-2 border-l-2 border-white border-b-2 border-r-2 border-gray-600 w-4 h-4 flex items-center justify-center font-bold text-[10px] leading-none active:border-t-gray-600 active:border-l-gray-600 active:border-b-white active:border-r-white" onclick="closeWindow('window-games')">x</button>
                </div>
                <div class="window-content flex-grow p-4 flex gap-6 flex-wrap content-start overflow-y-auto os-scroll font-sans text-black bg-white border-[3px] border-t-gray-600 border-l-gray-600 border-b-white border-r-white m-1">
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('snake')">
                    <div class="w-10 h-10 mx-auto bg-green-500 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">🐍</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Snake.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('tetris')">
                    <div class="w-10 h-10 mx-auto bg-red-500 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">🧱</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Tetris.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('dino')">
                    <div class="w-10 h-10 mx-auto bg-gray-500 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">🦖</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Dino.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('2048')">
                    <div class="w-10 h-10 mx-auto bg-yellow-500 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">🔢</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">2048.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('flappy')">
                    <div class="w-10 h-10 mx-auto bg-blue-500 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">🐦</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Flappy.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('memory')">
                    <div class="w-10 h-10 mx-auto bg-purple-500 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">🧠</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Memory.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('tictactoe')">
                    <div class="w-10 h-10 mx-auto bg-orange-500 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">❌</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">TicTacToe.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('wordle')">
                    <div class="w-10 h-10 mx-auto bg-green-600 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">📝</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Wordle.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('connect4')">
                    <div class="w-10 h-10 mx-auto bg-yellow-400 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">🟡</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Connect4.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('dontwordle')">
                    <div class="w-10 h-10 mx-auto bg-red-600 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">💣</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">DontWordle.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('colorguesser')">
                    <div class="w-10 h-10 mx-auto bg-gradient-to-br from-red-500 via-green-500 to-blue-500 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">🎨</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">ColorGuess.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" ondblclick="launchGame('gravitymaze')">
                    <div class="w-10 h-10 mx-auto bg-purple-600 rounded-sm shadow border border-gray-400 flex items-center justify-center text-white text-xl">🌌</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Gravity.exe</div>
                  </div>
                </div>
              </div>

              <!-- Readme Window -->
              <div id="window-readme" class="os-window hidden absolute top-12 left-12 w-[60%] h-[50%] bg-[#c0c0c0] border-[3px] border-gray-200 shadow-[2px_2px_10px_rgba(0,0,0,0.5)] pointer-events-auto flex flex-col" onmousedown="bringToFront(this)">
                <div class="window-titlebar bg-[#000080] text-white flex justify-between items-center px-1.5 py-1 cursor-default select-none">
                  <span class="font-pixel text-[8px] tracking-widest">Notepad - readme.txt</span>
                  <button class="close-btn bg-[#c0c0c0] text-black border-t-2 border-l-2 border-white border-b-2 border-r-2 border-gray-600 w-4 h-4 flex items-center justify-center font-bold text-[10px] leading-none active:border-t-gray-600 active:border-l-gray-600 active:border-b-white active:border-r-white" onclick="closeWindow('window-readme')">x</button>
                </div>
                <div class="window-content flex-grow p-2 overflow-y-auto os-scroll font-sans text-black text-[12px] whitespace-pre-wrap bg-white border-[3px] border-t-gray-600 border-l-gray-600 border-b-white border-r-white m-1 font-mono">
Welcome to Chimera OS!

This system is built for those who appreciate retro interfaces.
Explore the folders to see my projects and experiments.
You can run classic games in the GAMES folder, or use the Terminal to navigate the site. Have fun!

- Aneesh
                </div>
              </div>

              <!-- Archives Folder Window -->
              <div id="window-devlogs" class="os-window hidden absolute top-16 left-16 w-[75%] h-[65%] bg-[#c0c0c0] border-[3px] border-gray-200 shadow-[2px_2px_10px_rgba(0,0,0,0.5)] pointer-events-auto flex flex-col" onmousedown="bringToFront(this)">
                <div class="window-titlebar bg-[#000080] text-white flex justify-between items-center px-1.5 py-1 cursor-default select-none">
                  <span class="font-pixel text-[8px] tracking-widest">C:\DEVLOGS</span>
                  <button class="close-btn bg-[#c0c0c0] text-black border-t-2 border-l-2 border-white border-b-2 border-r-2 border-gray-600 w-4 h-4 flex items-center justify-center font-bold text-[10px] leading-none active:border-t-gray-600 active:border-l-gray-600 active:border-b-white active:border-r-white" onclick="closeWindow('window-devlogs')">x</button>
                </div>
                <div class="window-content flex-grow p-4 flex flex-col gap-2 overflow-y-auto os-scroll font-sans text-black bg-white border-[3px] border-t-gray-600 border-l-gray-600 border-b-white border-r-white m-1">
                  <p class="text-[12px] text-gray-500 mb-2 font-mono">0 items found. Archives are coming soon...</p>
                </div>
              </div>

              <!-- Labs Folder Window -->
              <div id="window-labs" class="os-window hidden absolute top-10 left-20 w-[75%] h-[65%] bg-[#c0c0c0] border-[3px] border-gray-200 shadow-[2px_2px_10px_rgba(0,0,0,0.5)] pointer-events-auto flex flex-col" onmousedown="bringToFront(this)">
                <div class="window-titlebar bg-[#000080] text-white flex justify-between items-center px-1.5 py-1 cursor-default select-none">
                  <span class="font-pixel text-[8px] tracking-widest">C:\LABS</span>
                  <button class="close-btn bg-[#c0c0c0] text-black border-t-2 border-l-2 border-white border-b-2 border-r-2 border-gray-600 w-4 h-4 flex items-center justify-center font-bold text-[10px] leading-none active:border-t-gray-600 active:border-l-gray-600 active:border-b-white active:border-r-white" onclick="closeWindow('window-labs')">x</button>
                </div>
                <div class="window-content flex-grow p-4 flex gap-6 flex-wrap content-start overflow-y-auto os-scroll font-sans text-black bg-white border-[3px] border-t-gray-600 border-l-gray-600 border-b-white border-r-white m-1">
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#password-checker', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg">🔑</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Pass.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#pathfinding', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg">🗺️</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Path.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#base64-hex', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg">🔄</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Base64.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#color-palette', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg">🎨</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Color.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#regex-tester', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg">🔍</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Regex.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#json-validator', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg font-bold">{ }</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Json.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#ascii-art', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg">👾</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Ascii.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#hash-gen', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg font-bold">#</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Hash.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#css-gradient', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg">🌈</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">CssGrad.exe</div>
                  </div>
                  <div class="text-center w-16 cursor-pointer hover:bg-blue-600 hover:text-white p-1 select-none group" onclick="window.open('/labs#unix-converter', '_blank')">
                    <div class="w-10 h-10 mx-auto bg-blue-200 border border-gray-400 flex items-center justify-center text-lg">⏱️</div>
                    <div class="text-[10px] mt-1 group-hover:bg-blue-800">Unix.exe</div>
                  </div>
                </div>
              </div>

                <div id="window-game-runner" class="os-window hidden absolute top-1 left-1 right-1 bottom-1 bg-[#c0c0c0] border-[3px] border-gray-200 shadow-[2px_2px_10px_rgba(0,0,0,0.5)] pointer-events-auto flex flex-col" onmousedown="bringToFront(this)">
                <div class="window-titlebar bg-[#000080] text-white flex justify-between items-center px-1.5 py-1 cursor-default select-none">
                  <span class="font-pixel text-[8px] tracking-widest" id="game-title">Game Runner</span>
                  <button class="close-btn bg-[#c0c0c0] text-black border-t-2 border-l-2 border-white border-b-2 border-r-2 border-gray-600 w-4 h-4 flex items-center justify-center font-bold text-[10px] leading-none active:border-t-gray-600 active:border-l-gray-600 active:border-b-white active:border-r-white" onclick="closeGame()">x</button>
                </div>
                <div class="window-content flex-grow relative overflow-hidden bg-black flex items-stretch justify-center border-[3px] border-t-gray-600 border-l-gray-600 border-b-white border-r-white m-1">
                  <!-- Game instances are pre-rendered but hidden, we show the active one -->
                  <div id="game-instance-snake" class="game-instance hidden w-full h-full overflow-hidden" style="zoom: 0.8;" tabindex="-1"><Snake /></div>
                  <div id="game-instance-tetris" class="game-instance hidden w-full h-full overflow-hidden" style="zoom: 0.7;" tabindex="-1"><Tetris /></div>
                  <div id="game-instance-dino" class="game-instance hidden w-full h-full overflow-hidden" style="zoom: 1;" tabindex="-1"><ChromeDino /></div>
                  <div id="game-instance-2048" class="game-instance hidden w-full h-full overflow-hidden" style="zoom: 0.65;" tabindex="-1"><Game2048 /></div>
                  <div id="game-instance-flappy" class="game-instance hidden w-full h-full overflow-hidden" style="zoom: 0.7;" tabindex="-1"><FlappyBird /></div>
                  <div id="game-instance-memory" class="game-instance hidden w-full h-full overflow-hidden" style="zoom: 0.6;" tabindex="-1"><MemoryMatch /></div>
                  <div id="game-instance-tictactoe" class="game-instance hidden w-full h-full overflow-hidden" style="zoom: 0.7;" tabindex="-1"><TicTacToe /></div>
                  <div id="game-instance-wordle" class="game-instance hidden w-full h-full overflow-hidden" style="zoom: 0.65;" tabindex="-1"><Wordle /></div>
