            <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
            <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
            <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
            <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
            <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
          </div>
          <div class="flex-1 flex gap-1">
            <div class="h-full w-8 bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
            <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
            <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
            <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
            <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
            <div class="h-full w-12 bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
          </div>
          <div class="flex-1 flex gap-1">
             <div class="h-full w-12 bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
             <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
             <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
             <div class="h-full flex-grow bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
             <div class="h-full w-16 bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
          </div>
          <div class="flex-1 flex gap-1 justify-center">
             <div class="h-full w-1/2 bg-[#c0c0c0] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-2px_4px_rgba(0,0,0,0.2),0_2px_2px_rgba(0,0,0,0.3)]"></div>
          </div>
        </div>

        <!-- Mouse -->
        <div class="css-mouse relative bg-[#d8d8d8] rounded-sm w-[15%] md:w-[12%] aspect-[2/3] shadow-[0_20px_40px_rgba(0,0,0,0.6)] flex justify-center p-2">
          <!-- Mouse Cable -->
          <div class="absolute -top-8 left-1/2 w-1.5 h-16 bg-[#222] rounded-none shadow-[2px_0_4px_rgba(0,0,0,0.5)] z-[-1]" style="transform: translateX(-50%) rotate(15deg); transform-origin: bottom center;"></div>
          
          <div class="w-full h-1/2 flex gap-1">
             <div class="h-full flex-grow bg-[#c8c8c8] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-1px_3px_rgba(0,0,0,0.1),0_1px_2px_rgba(0,0,0,0.2)]"></div>
             <div class="h-full flex-grow bg-[#c8c8c8] rounded-sm shadow-[inset_1px_1px_2px_#fff,inset_-1px_-1px_3px_rgba(0,0,0,0.1),0_1px_2px_rgba(0,0,0,0.2)]"></div>
          </div>
        </div>
      </div>
    </div>

    <style>
      /* Retro Monitor Details */
      .monitor-frame {
        border-bottom: 16px solid #b0b0b0;
        border-right: 8px solid #c0c0c0;
        border-left: 2px solid #fff;
        border-top: 2px solid #fff;
      }
      .inner-bezel {
        border-bottom: 8px solid #111;
        border-right: 4px solid #1a1a1a;
        border-top: 4px solid #555;
        border-left: 4px solid #444;
      }
      
      /* Keyboard & Mouse Details */
      .css-keyboard {
        border-bottom: 12px solid #b0b0b0;
        border-right: 6px solid #c0c0c0;
        border-top: 2px solid #fff;
        border-left: 2px solid #fff;
      }
      .css-mouse {
        border-bottom: 8px solid #b0b0b0;
        border-right: 6px solid #c0c0c0;
        border-left: 2px solid #fff;
        border-top: 2px solid #fff;
      }
      
      /* Subtle scanlines specifically for the crt screen */
      .crt-screen::after {
        content: " ";
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;
        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.05) 50%);
        z-index: 9999;
        background-size: 100% 2px, 3px 100%;
        pointer-events: none;
      }

      /* Custom scrollbar */
      .os-scroll {
        scrollbar-width: auto;
        scrollbar-color: #c0c0c0 #ffffff;
      }
      .os-scroll::-webkit-scrollbar {
        width: 16px;
      }
      .os-scroll::-webkit-scrollbar-track {
        background: url('data:image/svg+xml;utf8,<svg width="2" height="2" viewBox="0 0 2 2" xmlns="http://www.w3.org/2000/svg"><rect width="1" height="1" fill="%23dfdfdf"/><rect x="1" y="1" width="1" height="1" fill="%23dfdfdf"/><rect x="1" width="1" height="1" fill="%23ffffff"/><rect y="1" width="1" height="1" fill="%23ffffff"/></svg>') repeat;
        border-left: 1px solid #dfdfdf;
      }
      .os-scroll::-webkit-scrollbar-thumb {
        background: #c0c0c0;
        border-top: 1px solid #ffffff;
        border-left: 1px solid #ffffff;
        border-right: 1px solid #808080;
        border-bottom: 1px solid #808080;
        border-radius: 0;
        box-shadow: inset 1px 1px 0px 0px #dfdfdf, inset -1px -1px 0px 0px #0a0a0a;
      }
      .os-scroll::-webkit-scrollbar-thumb:hover {
        background: #d0d0d0;
      }
      .os-scroll::-webkit-scrollbar-button {
        display: none;
      }

      /* Hide all scrollbars inside game instances */
      .game-instance,
      .game-instance *,
      #window-game-runner .window-content,
      #window-game-runner .window-content * {
        scrollbar-width: none !important;
      }
      .game-instance::-webkit-scrollbar,
      .game-instance *::-webkit-scrollbar,
      #window-game-runner .window-content::-webkit-scrollbar,
      #window-game-runner .window-content *::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }

      /* No focus outline on game containers */
      .game-instance:focus {
        outline: none;
      }

      /* Flappy bird fix: no light blue background bleed */
      #game-instance-flappy > * {
        background: #000 !important;
      }

      /* Desktop icon hover effect */
      .desktop-icon:hover span {
        background: #000080;
        color: white;
      }
    </style>

    <script define:vars={{ projects }}>
      // 1. Clock Logic
      function updateClock() {
        const now = new Date();
        let hours = now.getHours();
        const minutes = now.getMinutes().toString().padStart(2, '0');
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12;
        const clockEl = document.getElementById('taskbar-clock');
        if (clockEl) clockEl.textContent = `${hours}:${minutes} ${ampm}`;
      }
      setInterval(updateClock, 1000);
      updateClock();

      // 2. Window Management
      let zIndexCounter = 100;
      
      // Keep track of active windows
      const activeWindows = new Set();
      
      function updateTaskbar() {
        const container = document.getElementById('taskbar-windows');
        if (!container) return;
        
        container.innerHTML = '';
        activeWindows.forEach(winId => {
          const winEl = document.getElementById(winId);
          if (winEl && !winEl.classList.contains('hidden')) {
            const title = winEl.querySelector('.window-titlebar span').textContent;
            
            const btn = document.createElement('button');
            btn.className = "bg-[#c0c0c0] h-full border-t-2 border-l-2 border-white border-b-2 border-r-2 border-gray-600 px-2 flex items-center justify-center font-pixel text-[6px] text-black w-24 truncate active:border-t-gray-600 active:border-l-gray-600 active:border-b-white active:border-r-white";
            // Check if it's the topmost window
            if (winEl.style.zIndex == zIndexCounter) {
              btn.classList.add('bg-gray-300', 'border-t-gray-600', 'border-l-gray-600', 'border-b-white', 'border-r-white');
            }
            btn.textContent = title;
            btn.onclick = () => {
              if (winEl.style.zIndex == zIndexCounter) {
                // If it's on top, minimize it
                winEl.classList.add('hidden');
              } else {
                winEl.classList.remove('hidden');
                bringToFront(winEl);
              }
              updateTaskbar();
            };
            container.appendChild(btn);
          }
        });
      }

      window.openWindow = function(windowId) {
        const win = document.getElementById(windowId);
        if (win) {
          win.classList.remove('hidden');
          bringToFront(win);
          activeWindows.add(windowId);
          updateTaskbar();
        }
      }
      window.closeWindow = function(windowId) {
        const win = document.getElementById(windowId);
        if (win) {
          win.classList.add('hidden');
          activeWindows.delete(windowId);
          updateTaskbar();
        }
      }
      window.bringToFront = function(winEl) {
        zIndexCounter++;
        winEl.style.zIndex = zIndexCounter;
        updateTaskbar();
      }

      // Make windows draggable
      const windows = document.querySelectorAll('.os-window');
      windows.forEach(win => {
        const titlebar = win.querySelector('.window-titlebar');
        let isDragging = false;
        let offsetX = 0;
        let offsetY = 0;

        titlebar.addEventListener('mousedown', (e) => {
          if (e.target.closest('.close-btn')) return;
          isDragging = true;
          bringToFront(win);
          
          const rect = win.getBoundingClientRect();
          const parentRect = win.parentElement.getBoundingClientRect();
          
          // These coordinates are relative to the screen, which works well enough
          // even with transforms if we calculate carefully.
          offsetX = e.clientX - rect.left;
          offsetY = e.clientY - rect.top;
        });

        document.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          
          const parentRect = win.parentElement.getBoundingClientRect();
          
          // Calculate scale to adjust drag speed for 3D transform
          const scale = parentRect.width / win.parentElement.offsetWidth;
          
          let newLeft = (e.clientX - parentRect.left - offsetX) / scale;
          let newTop = (e.clientY - parentRect.top - offsetY) / scale;
          
          win.style.left = `${newLeft}px`;
          win.style.top = `${newTop}px`;
        });

        document.addEventListener('mouseup', () => {
          isDragging = false;
        });
      });

      // 3. Game Launching Logic
      window.launchGame = function(gameId) {
        const runner = document.getElementById('window-game-runner');
        const title = document.getElementById('game-title');
        
        // Hide all instances
        document.querySelectorAll('.game-instance').forEach(inst => inst.classList.add('hidden'));
        
        // Show selected
        const selected = document.getElementById(`game-instance-${gameId}`);
        if (selected) {
          selected.classList.remove('hidden');
          title.textContent = `${gameId.toUpperCase()}.EXE`;
          openWindow('window-game-runner');
          // Focus the game container so keyboard events reach it
          setTimeout(() => {
            // For Dino, focus the iframe directly
            if (gameId === 'dino') {
              const iframe = selected.querySelector('iframe');
              if (iframe) {
                iframe.removeAttribute('tabindex');
                iframe.contentWindow?.focus();
              }
            } else {
              // Focus the game container so document keydown events work
              selected.setAttribute('tabindex', '0');
              selected.focus({ preventScroll: true });
            }
          }, 100);
        }
      }
      window.closeGame = function() {
        closeWindow('window-game-runner');
        document.querySelectorAll('.game-instance').forEach(inst => inst.classList.add('hidden'));
      }

      // 4. Terminal Logic
      const input = document.getElementById("cmd-input");
      const output = document.getElementById("terminal-output");
      const container = document.getElementById("terminal-container");
      const promptPrefix = document.getElementById("prompt-prefix");

      let currentDir = "~";
      let currentUser = "guest";
      const validRoutes = ["about", "projects", "devlog", "guestbook", "contact", "labs", "games"];

      const staticCommands = {
        help: "Available commands:<br/>  help     - Show this message<br/>  about    - About the creator<br/>  ls       - List directory contents<br/>  pwd      - Print working directory<br/>  whoami   - Print current user<br/>  date     - Print current date and time<br/>  echo     - Echo text back<br/>  cat      - Print file contents<br/>  clear    - Clear the terminal screen<br/>  cd       - Navigate (e.g. cd about, cd ..)",
        about: "Hi, I'm Aneesh.<br/>I build things for the web. I like cats, dogs, and pixel art.",
      };

      function updatePrompt() {
        if (promptPrefix) {
           promptPrefix.textContent = `C:\\>`;
        }
      }

      function printLine(text, isCommand = false) {
        if (!output) return;
        const line = document.createElement("div");
        line.className = "mb-2";
        if (isCommand) {
          line.innerHTML = `<span class="text-green mr-3 font-bold">C:\\></span><span class="text-text-primary uppercase">${text}</span>`;
        } else {
          line.innerHTML = `<span class="text-text-primary leading-loose tracking-wider whitespace-pre-wrap">${text}</span>`;
        }
        output.appendChild(line);
        if (container) {
          container.scrollTop = container.scrollHeight;
        }
      }

      input?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          const rawVal = input.value.trim();
          const val = rawVal.toLowerCase();
          const parts = val.split(/\s+/);
          const cmd = parts[0];
          const args = parts.slice(1);
          
          input.value = "";
          if (!val) return;
          
          printLine(rawVal, true);

          if (cmd === "clear") {
            if (output) output.innerHTML = "";
            return;
          }

          if (cmd === "ls" || cmd === "dir") {
             let out = "<div class='flex flex-wrap gap-x-4 gap-y-2 text-blue font-bold'>";
             out += "<div>GAMES/</div><div>DEVLOGS/</div><div>LABS/</div>";
             out += "<div class='text-text-primary font-normal'>readme.txt</div>";
             out += "</div>";
             printLine(out);
             return;
          }

          if (cmd === "echo") {
             printLine(rawVal.substring(5));
             return;
          }
          
          if (cmd === "cat" || cmd === "type") {
             const file = args[0];
             if (!file) {
                 printLine("missing file operand");
             } else if (file === "readme.txt") {
                 printLine("Welcome to Chimera OS!\nThis system is built for those who appreciate retro interfaces.\nExplore the folders to see my projects and experiments.\nYou can run classic games in the GAMES folder, or use the Terminal to navigate the site. Have fun!\n\n- Aneesh");
             } else {
                 printLine(`File not found: ${file}`);
             }
             return;
          }

          if (cmd === "cd") {
            const dir = args[0] || "~";
            if (dir === "..") {
               printLine("");
               return;
            }
            if (dir.toLowerCase() === "games") {
               openWindow('window-games');
               return;
            }
            if (dir.toLowerCase() === "devlogs") {
               openWindow('window-devlogs');
               return;
            }
            if (dir.toLowerCase() === "labs") {
               openWindow('window-labs');
               return;
            }
            
            printLine(`Path not found: ${dir}`);
            return;
          }

          if (staticCommands[cmd]) {
            printLine(staticCommands[cmd]);
          } else {
            printLine(`Bad command or file name`);
          }
        }
      });
      
      // Load color theme from localStorage if it exists, otherwise default to mocha
      const theme = localStorage.getItem("theme") || "mocha";
      document.documentElement.setAttribute("data-theme", theme);
      
      updatePrompt();
    </script>
  </body>
</html>
