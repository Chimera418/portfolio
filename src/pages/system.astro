            <!-- Taskbar -->
            <div id="taskbar" class="absolute bottom-0 w-full h-[28px] bg-[#c0c0c0] border-t-2 border-white flex items-center px-1 z-40 justify-between select-none shadow-[0_-1px_2px_rgba(0,0,0,0.2)]">
              <div class="flex gap-1 items-center h-full py-0.5">
                <button class="bg-[#c0c0c0] h-full border-t-2 border-l-2 border-white border-b-2 border-r-2 border-gray-600 px-2 flex items-center justify-center gap-1 active:border-t-gray-600 active:border-l-gray-600 active:border-b-white active:border-r-white font-pixel text-[8px] text-black font-bold" onclick="alert('Start menu clicked!')">
                  <span class="text-blue-700 text-[10px] leading-none">C</span> Start
                </button>
                <div class="w-px h-full bg-gray-400 mx-1 border-r border-white"></div>
                <div id="taskbar-windows" class="flex gap-1 h-full">
                  <!-- Active window buttons will appear here -->
                </div>
              </div>
              
              <div class="bg-[#c0c0c0] h-[80%] border-t-2 border-l-2 border-gray-600 border-b-2 border-r-2 border-white px-2 flex items-center font-pixel text-[8px] text-black" id="taskbar-clock">
