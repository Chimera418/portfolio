---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import NotionBlockRenderer from '../../../components/archive/NotionBlockRenderer.astro';
import { getArchiveEntryBySlug } from '../../../lib/notion/queries';
import { getBlocks } from '../../../lib/notion/blocks';
import type { ArchiveType } from '../../../lib/notion/types';

const { type, slug } = Astro.params;

const allowedTypes = ['devlogs', 'blogs', 'writeups', 'notes'];
if (!type || !slug || !allowedTypes.includes(type)) {
  return Astro.rewrite('/404');
}

const entry = await getArchiveEntryBySlug(type as ArchiveType, slug);

if (!entry) {
  // Safe failure state on missing or duplicate slug
  return Astro.rewrite('/404');
}

// Fetch the blocks (strictly cached for 3 minutes to keep signed URLs fresh)
const blocks = await getBlocks(entry.id);

const displayDate = new Date(entry.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout 
  title={`${entry.title} | ${type.charAt(0).toUpperCase() + type.slice(1)}`}
  description={entry.description}
  ogImage={entry.image}
>
  <Navbar />
  
  <article class="mt-8 max-w-4xl mx-auto px-4 pb-20 animate-fade-in">
    <!-- Header -->
    <header class="mb-12 text-center">
      {entry.image && (
        <img 
          src={entry.image} 
          alt={entry.title} 
          class="w-full h-64 md:h-96 object-cover rounded-xl mb-8 border-2 border-surface0"
        />
      )}
      
      <div class="flex flex-wrap justify-center gap-2 mb-6">
        {entry.tags.map(tag => (
          <span class="px-2 py-1 bg-surface-bright border border-highlight-med text-text-muted text-[10px] uppercase tracking-wider font-pixel rounded">
            {tag}
          </span>
        ))}
      </div>

      <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">
        {entry.title}
      </h1>
      
      <div class="flex items-center justify-center gap-4 text-text-muted font-pixel text-sm">
        <time datetime={entry.date}>{displayDate}</time>
        <span>•</span>
        <a href={`/archive/${type}`} class="hover:text-primary transition-colors hover:underline uppercase">
          {type}
        </a>
      </div>
      
      {entry.link || entry.github ? (
        <div class="mt-6 flex justify-center gap-4">
          {entry.link && (
            <a href={entry.link} target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-primary text-crust font-bold rounded hover:bg-primary-hover transition-colors">
              Visit Site
            </a>
          )}
          {entry.github && (
            <a href={entry.github} target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-surface-dim border border-highlight-med text-text-primary font-bold rounded hover:border-primary transition-colors">
              GitHub Repo
            </a>
          )}
        </div>
      ) : null}
    </header>

    <!-- Content -->
    <div class="prose prose-invert prose-mocha max-w-none prose-img:rounded-xl">
      <NotionBlockRenderer blocks={blocks} />
    </div>
  </article>
</Layout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  /* Custom prose styles to match the theme */
  .prose-mocha {
    --tw-prose-body: var(--color-text-primary);
    --tw-prose-headings: var(--color-text-primary);
    --tw-prose-links: var(--color-primary);
    --tw-prose-bold: var(--color-text-primary);
    --tw-prose-hr: var(--color-surface0);
    --tw-prose-quotes: var(--color-text-primary);
    --tw-prose-quote-borders: var(--color-primary);
    --tw-prose-code: var(--color-primary);
  }
</style>
