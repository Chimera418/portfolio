---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import BentoCard from '../../components/BentoCard.astro';
import { getPublishedTypes } from '../../lib/notion/queries';

const ALL_FOLDERS = [
  {
    title: 'Devlogs',
    type: 'devlogs',
    description: 'Build logs, technical notes, and dev updates.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>`,
  },
  {
    title: 'Writeups',
    type: 'writeups',
    description: 'CTF challenges, bug bounty, and security research.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 3l1.664 9.526a2.25 2.25 0 002.186 1.849H15M3 3l-.291-1.457M3 3h-.375M3 3l1.664 9.526M15 12a3 3 0 110-6 3 3 0 010 6z"/>`,
  },
  {
    title: 'Blogs',
    type: 'blogs',
    description: 'Thoughts, opinions, and longer-form articles.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/>`,
  },
  {
    title: 'Notes',
    type: 'notes',
    description: 'Snippets, cheat sheets, and reference material.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>`,
  },
];

const publishedTypes = await getPublishedTypes();
const folders = ALL_FOLDERS.filter(f => publishedTypes.includes(f.type as any));
---
<Layout title="Archive | Chimera's Realm">
  <Navbar />

  <div class="mt-8 max-w-5xl mx-auto space-y-8 animate-fade-in px-4 md:px-0">

    <!-- Header -->
    <section>
      <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-3">
        The <span class="text-primary font-pixel text-2xl md:text-3xl align-middle">Archive</span>
      </h1>
      <p class="font-mono text-xs text-text-muted">
        <span class="text-primary/70">chimera@realm</span>
        <span class="text-text-muted/40"> ~ </span>
        <span class="text-text-primary/80">ls ./archive/</span>
      </p>
    </section>

    <!-- Category Grid -->
    {folders.length === 0 ? (
      <BentoCard className="text-center p-10 max-w-2xl mx-auto">
        <p class="font-mono text-sm text-text-muted">
          <span class="text-primary">$</span> find . -name "*.published"
          <span class="text-red/80 ml-2">→ 0 results</span>
        </p>
        <p class="text-text-muted/50 text-xs mt-2 font-mono">Nothing published yet — check back soon.</p>
      </BentoCard>
    ) : (
      <section class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6">
        {folders.map(folder => (
          <a
            href={`/archive/${folder.type}`}
            class="block group outline-none"
          >
            <BentoCard className="h-full transition-transform duration-300 group-hover:-translate-y-1 group-hover:shadow-[0_8px_30px_rgba(0,0,0,0.4)] group-hover:border-secondary cursor-pointer" glow={false}>
              
              <!-- Icon + Title row -->
              <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-4">
                  <div class="p-2.5 rounded-lg bg-overlay border border-highlight-med text-primary group-hover:text-secondary group-hover:border-secondary transition-colors duration-300">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={folder.icon} />
                  </div>
                  <h2 class="text-2xl font-bold text-text-primary group-hover:text-secondary transition-colors duration-300">
                    {folder.title}
                  </h2>
                </div>
                <div class="pt-2 pr-1">
                   <svg class="w-5 h-5 text-text-muted/30 group-hover:text-secondary transition-colors duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                     <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                   </svg>
                </div>
              </div>

              <!-- Description -->
              <p class="text-sm text-text-muted mb-6 flex-grow leading-relaxed">
                {folder.description}
              </p>

              <!-- Pixel path label -->
              <div class="mt-auto pt-4 border-t border-highlight-med/30">
                <span class="font-pixel text-[10px] text-text-muted/60 uppercase tracking-[0.15em] group-hover:text-secondary transition-colors duration-300">
                  ./archive/{folder.type}/
                </span>
              </div>

            </BentoCard>
          </a>
        ))}
      </section>
    )}
  </div>
</Layout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.4s ease-out forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
