---
import type { ArchiveListItem } from '../../lib/notion/types';

export interface Props {
  entry: ArchiveListItem;
}

const { entry } = Astro.props;

// Use the explicit date or fallback
const displayDate = new Date(entry.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<a href={`/archive/${entry.type}s/${entry.slug}`} class="block bg-surface-dim border-2 border-highlight-med rounded-xl p-6 hover:border-primary transition-colors group">
  <div class="flex flex-col md:flex-row justify-between md:items-center mb-2 gap-2">
    <h2 class="text-2xl font-bold text-text-primary group-hover:text-primary transition-colors">{entry.title}</h2>
    <span class="font-pixel text-[10px] text-text-muted whitespace-nowrap">
      {displayDate}
    </span>
  </div>
  <p class="text-text-muted mb-4">{entry.description}</p>
  <div class="flex flex-wrap gap-2">
    {entry.tags.map(tag => (
      <span class="px-2 py-1 bg-surface-bright border border-highlight-med text-text-muted text-[10px] uppercase tracking-wider font-pixel rounded">
        {tag}
      </span>
    ))}
  </div>
</a>
