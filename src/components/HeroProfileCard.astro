---
import BentoCard from "./BentoCard.astro";
import InteractiveBlob from "./InteractiveBlob";
import "feral-blob/blob.css";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<BentoCard className={`hero-card-element ${className || ""} z-20`} glow={true}>
  <div class="flex flex-col justify-between h-full gap-4 py-1">
    <!-- Top: name block -->
    <div class="flex flex-col sm:flex-row justify-between items-start gap-6">
      <div class="space-y-4 flex-1">
        <div>
          <p
            class="text-text-muted font-pixel text-[10px] uppercase tracking-[0.25em] mb-3 opacity-70"
          >
            Aneesh Sagar Reddy <span class="text-secondary font-bold">AKA</span>
          </p>
          <h1
            id="hero-title"
            data-text="CHIMERA"
            class="w-fit text-[2.5rem] sm:text-5xl md:text-6xl font-bold text-text-primary tracking-tight font-pixel uppercase leading-none drop-shadow-sm cursor-default break-words hyphens-none"
          >
            Chimera
          </h1>
          <p
            class="text-secondary font-pixel text-[10px] uppercase tracking-widest mt-3 opacity-90"
          >
            Full Stack &bull; Cybersecurity &bull; AI ENGINEERING
          </p>
        </div>

        <p class="text-text-muted text-sm leading-relaxed max-w-lg">
          Welcome to my corner of the internet — mostly projects I built
          because something annoyed me or I got curious. There's a guestbook if
          you want to say hi, and a few things hidden around if you like poking
          at stuff.
        </p>
      </div>

      <!-- Scaled up blob taking the right side space -->
      <div
        class="w-48 h-48 sm:w-56 sm:h-56 md:w-64 md:h-64 flex-shrink-0 self-center sm:self-center pointer-events-auto mt-4 sm:mt-0"
      >
        <InteractiveBlob client:load className="w-full h-full" />
      </div>
    </div>

    <!-- Bottom: status badges -->
    <div
      class="mt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-2 border-t border-highlight-med/30 pt-4"
    >
      <div
        class="flex items-center gap-2 text-[9px] font-pixel text-text-muted uppercase tracking-wider"
      >
        <span
          id="hero-status-icon"
          class="inline-flex items-center justify-center"
        >
          <svg
            class="w-2.5 h-2.5 text-text-muted fill-current -translate-y-[1px]"
            viewBox="0 0 24 24"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM7.5 12C7.5 9.51472 9.51472 7.5 12 7.5C14.4853 7.5 16.5 9.51472 16.5 12C16.5 14.4853 14.4853 16.5 12 16.5C9.51472 16.5 7.5 14.4853 7.5 12Z"
            ></path>
          </svg>
        </span>
        <span id="hero-status-text">Connecting...</span>
      </div>
      <div class="flex items-center gap-3 pl-[14px] sm:pl-0">
        <div
          tabindex="0"
          class="relative group/location inline-block focus:outline-none"
        >
          <span
            class="text-[9px] font-pixel text-text-muted uppercase tracking-wider cursor-help border-b border-dashed border-text-muted/50 pb-[1px] hover:text-primary transition-colors"
            >BLR, IN</span
          >
          <!-- Tooltip -->
          <div
            class="absolute bottom-full left-0 sm:left-1/2 sm:-translate-x-1/2 mb-3 w-max opacity-0 group-hover/location:opacity-100 group-focus/location:opacity-100 transition-all duration-200 pointer-events-none z-50 translate-y-1 group-hover/location:translate-y-0 group-focus/location:translate-y-0"
          >
            <div
              class="bg-overlay border border-highlight-med rounded-lg px-2.5 py-1.5 shadow-xl shadow-black/50 backdrop-blur-sm"
            >
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                  <svg
                    class="w-3.5 h-3.5 text-text-muted translate-y-[-1px]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><circle cx="12" cy="12" r="10"></circle><polyline
                      points="12 6 12 12 16 14"></polyline></svg
                  >
                  <span
                    class="text-xs font-bold text-text-primary font-mono tracking-tight"
                    id="hero-clock">--:-- --</span
                  >
                </div>
                <div class="w-px h-3 bg-highlight-med/50"></div>
                <div class="flex items-center gap-1.5">
                  <svg
                    class="w-3.5 h-3.5 text-secondary translate-y-[-1px]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                    ></path></svg
                  >
                  <span
                    class="text-xs font-bold text-text-primary font-mono tracking-tight"
                    id="hero-weather">--°C</span
                  >
                </div>
              </div>
            </div>
            <!-- Arrow -->
            <div
              class="absolute -bottom-1 left-4 sm:left-1/2 sm:-translate-x-1/2 w-2 h-2 bg-overlay border-r border-b border-highlight-med rotate-45"
            >
            </div>
          </div>
        </div>

        <span class="text-highlight-med/40">|</span>

        <div
          tabindex="0"
          class="relative group/edu inline-block focus:outline-none"
        >
          <span
            class="text-[9px] font-pixel text-text-muted uppercase tracking-wider cursor-help border-b border-dashed border-text-muted/50 pb-[1px] hover:text-primary transition-colors"
            >CSE-AI &apos;28</span
          >
          <!-- Tooltip -->
          <div
            class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-max opacity-0 group-hover/edu:opacity-100 group-focus/edu:opacity-100 transition-all duration-200 pointer-events-none z-50 translate-y-1 group-hover/edu:translate-y-0 group-focus/edu:translate-y-0"
          >
            <div
              class="bg-overlay border border-highlight-med rounded-lg px-2.5 py-1.5 shadow-xl shadow-black/50 backdrop-blur-sm"
            >
              <div class="flex items-center gap-1.5">
                <svg
                  class="w-3.5 h-3.5 text-secondary translate-y-[-2px]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
                <span
                  class="text-[10px] font-pixel text-text-primary uppercase tracking-wide z-50 text-center leading-[1.4]"
                  >Amrita Vishwa<br />Vidyapeetham</span
                >
              </div>
            </div>
            <!-- Arrow -->
            <div
              class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-overlay border-r border-b border-highlight-med rotate-45"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BentoCard>

<script>
  import anime from "animejs/lib/anime.es.js";

  (function () {
    // Clock & Weather logic
    function updateHeroClock() {
      const el = document.getElementById("hero-clock");
      if (!el) return;

      const now = new Date();
      const ist = new Date(
        now.toLocaleString("en-US", { timeZone: "Asia/Kolkata" }),
      );

      let hours = ist.getHours();
      const ampm = hours >= 12 ? "PM" : "AM";
      hours = hours % 12;
      hours = hours ? hours : 12;
      const mm = String(ist.getMinutes()).padStart(2, "0");

      el.textContent = `${hours}:${mm} ${ampm}`;
    }

    async function updateWeather() {
      const el = document.getElementById("hero-weather");
      if (!el) return;
      try {
        const res = await fetch(
          "https://api.open-meteo.com/v1/forecast?latitude=12.9716&longitude=77.5946&current=temperature_2m",
        );
        const data = await res.json();
        const temp = Math.round(data.current.temperature_2m);
        el.textContent = `${temp}°C`;
      } catch (err) {
        console.error("Failed to fetch weather:", err);
      }
    }

    async function updateDiscordStatus() {
      const el = document.getElementById("hero-status-text");
      const iconContainer = document.getElementById("hero-status-icon");
      if (!el || !iconContainer) return;
      try {
        const res = await fetch(
          "https://api.lanyard.rest/v1/users/736465046317563915",
        );
        const { data } = await res.json();
        const status = data.discord_status;

        const translateClass = "-translate-y-[1px]";
        let svg = "";

        if (status === "online") {
          el.textContent = "Online";
          svg = `<svg class="w-2.5 h-2.5 text-[#23a559] fill-current ${translateClass}" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /></svg>`;
        } else if (status === "idle") {
          el.textContent = "Idle";
          svg = `<svg class="w-2.5 h-2.5 text-[#f0b232] fill-current ${translateClass}" viewBox="0 0 24 24"><path d="M21.026 13.063c-5.097-.487-9.273-4.705-9.273-9.672 0-1.04.206-2.04.58-2.966C6.442.924 2 5.923 2 12c0 5.523 4.477 10 10 10 4.13 0 7.674-2.507 9.176-6.046a9.957 9.957 0 0 1-.15-2.89Z" /></svg>`;
        } else if (status === "dnd") {
          el.textContent = "Do Not Disturb";
          svg = `<svg class="w-2.5 h-2.5 text-[#f23f43] fill-current ${translateClass}" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM6.25 12C6.25 11.5858 6.58579 11.25 7 11.25H17C17.4142 11.25 17.75 11.5858 17.75 12C17.75 12.4142 17.4142 12.75 17 12.75H7C6.58579 12.75 6.25 12.4142 6.25 12Z" /></svg>`;
        } else {
          el.textContent = "Offline";
          svg = `<svg class="w-2.5 h-2.5 text-text-muted fill-current ${translateClass}" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM7.5 12C7.5 9.51472 9.51472 7.5 12 7.5C14.4853 7.5 16.5 9.51472 16.5 12C16.5 14.4853 14.4853 16.5 12 16.5C9.51472 16.5 7.5 14.4853 7.5 12Z" /></svg>`;
        }
        iconContainer.innerHTML = svg;
      } catch (err) {
        console.error("Failed to fetch Discord status:", err);
      }
    }

    updateHeroClock();
    updateWeather();
    updateDiscordStatus();
    setInterval(updateHeroClock, 1000);
    setInterval(updateWeather, 3600000); // 1 hour
    setInterval(updateDiscordStatus, 30000); // 30 seconds

    // Scramble Text Logic for "Chimera"
    const titleEl = document.getElementById("hero-title");
    if (titleEl) {
      const originalText = titleEl.dataset.text || "CHIMERA";
      // Using only standard ASCII to ensure the monospace pixel font doesn't fall back and cause layout shift
      const chars = "!<>-_\\/[]{}|=+*^?#@";
      let isAnimating = false;

      titleEl.addEventListener("mouseenter", () => {
        if (isAnimating) return;
        isAnimating = true;

        let iteration = 0;

        const animation = anime({
          targets: titleEl,
          duration: 1200,
          easing: "linear",
          update: function () {
            // Lower increment = slower reveal
            iteration += 0.1;

            titleEl.textContent = originalText
              .split("")
              .map((letter, index) => {
                if (index < iteration) {
                  return originalText[index];
                }
                return chars[Math.floor(Math.random() * chars.length)];
              })
              .join("");
          },
          complete: function () {
            titleEl.textContent = originalText;
            isAnimating = false;
          },
        });
      });
    }
  })();
</script>
